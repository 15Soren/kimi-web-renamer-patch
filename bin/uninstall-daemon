#!/usr/bin/env bash
# 停止并移除 kimi-renamer 守护进程。
set -euo pipefail

UNIT_DIR="$HOME/.config/systemd/user"
UNIT="$UNIT_DIR/kimi-renamer-watch.service"

if [ -d /run/systemd/system ]; then
  systemctl --user disable --now kimi-renamer-watch.service 2>/dev/null || true
  systemctl --user daemon-reload 2>/dev/null || true
fi

rm -f "$UNIT"

KIMI_CODE_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"
STATE_DIR="$KIMI_CODE_HOME/kimi-renamer"
for PID_FILE in "$STATE_DIR/daemon.pid" "$STATE_DIR/sidecar.pid"; do
  if [ -f "$PID_FILE" ]; then
    PID="$(sed -n 's/.*"pid"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p; /^[0-9][0-9]*$/p' "$PID_FILE" | head -n 1)"
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
      kill "$PID" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
  fi
done

echo "✅ 守护进程与 sidecar 已停止并移除"

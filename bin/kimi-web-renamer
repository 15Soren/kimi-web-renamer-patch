#!/usr/bin/env node
// 启动 sidecar（如未运行）、在运行期间自动保活 dist-web 注入，并执行 kimi web；退出时一并清理。跨平台支持 Linux / macOS / Windows。
const fs = require("fs");
const http = require("http");
const path = require("path");
const { spawn } = require("child_process");
const {
  serverConfigPath,
  listCacheRoots,
  normalizePathKey,
  findExecutablesInPath,
} = require("../src/paths");
const {
  listDistWebDirs,
  checkStatus,
  applyPatch,
  readServerConfig,
} = require("../src/modes/standalone");

const ROOT = path.resolve(__dirname, "..");

function checkHealth(port) {
  return new Promise((resolve) => {
    const req = http.get({ host: "127.0.0.1", port, path: "/health", timeout: 1000 }, (res) => {
      res.resume();
      resolve(res.statusCode === 200);
    });
    req.on("error", () => resolve(false));
    req.on("timeout", () => {
      req.destroy();
      resolve(false);
    });
  });
}

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

function quoteCmdArg(arg) {
  const str = String(arg);
  if (!str) return '""';
  if (/[\s"&|<>^()]/.test(str)) {
    return `"${str.replace(/"/g, '""')}"`;
  }
  return str;
}

/**
 * 解析 kimi 可执行文件并按平台安全启动（避免 Windows 下 shell: true 触发 DEP0190 与含空格路径失败）
 */
function spawnKimiWeb(kimiBin, extraArgs) {
  const webArgs = ["web", ...extraArgs];
  if (process.platform !== "win32") {
    return spawn(kimiBin, webArgs, { stdio: "inherit" });
  }

  const resolvedList = findExecutablesInPath(kimiBin);
  const resolved = resolvedList[0] || kimiBin;
  const lower = resolved.toLowerCase();

  if (lower.endsWith(".cmd") || lower.endsWith(".bat")) {
    const comspec = process.env.ComSpec || "cmd.exe";
    const cmdLine = `"${quoteCmdArg(resolved)} ${webArgs.map(quoteCmdArg).join(" ")}"`;
    return spawn(comspec, ["/d", "/s", "/c", cmdLine], {
      stdio: "inherit",
      windowsVerbatimArguments: true,
    });
  }

  return spawn(resolved, webArgs, {
    stdio: "inherit",
    shell: false,
  });
}

/**
 * 启动进程内轻量补丁守护，解决单文件 kimi web 启动时还原 index.html 的问题
 */
function startInlineReinjector(configPath) {
  const watchers = new Map();
  let debounceTimer = null;
  let injecting = false;

  const ensureOnce = () => {
    if (injecting) return;
    if (!readServerConfig(configPath)) return;
    injecting = true;
    try {
      for (const webDir of listDistWebDirs()) {
        const status = checkStatus(webDir, { serverConfigPath: configPath });
        if (status.isHtmlPatched && status.isRenamerJsPresent && status.isRenamerIcoPresent) continue;
        try {
          applyPatch(webDir, { serverConfigPath: configPath });
        } catch (e) {
          // kimi web 正在写入文件时允许下一轮重试
        }
      }
    } finally {
      injecting = false;
    }
  };

  const scheduleEnsure = () => {
    if (debounceTimer) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      debounceTimer = null;
      ensureOnce();
    }, 200);
  };

  const syncWatchers = () => {
    for (const [key, entry] of watchers.entries()) {
      if (!fs.existsSync(entry.root)) {
        try {
          entry.watcher.close();
        } catch (e) {
          // 忽略
        }
        watchers.delete(key);
      }
    }
    for (const root of listCacheRoots()) {
      const key = normalizePathKey(root);
      if (watchers.has(key) || !fs.existsSync(root)) continue;
      try {
        const watcher = fs.watch(root, { recursive: true }, scheduleEnsure);
        watcher.on("error", () => {
          try {
            watcher.close();
          } catch (e) {
            // 忽略
          }
          watchers.delete(key);
        });
        watchers.set(key, { root, watcher });
      } catch (e) {
        // 退回轮询
      }
    }
  };

  syncWatchers();
  ensureOnce();
  const pollTimer = setInterval(() => {
    syncWatchers();
    ensureOnce();
  }, 1500);

  return () => {
    clearInterval(pollTimer);
    if (debounceTimer) {
      clearTimeout(debounceTimer);
      debounceTimer = null;
    }
    for (const entry of watchers.values()) {
      try {
        entry.watcher.close();
      } catch (e) {
        // 忽略
      }
    }
    watchers.clear();
  };
}

async function main() {
  const configPath = serverConfigPath();
  if (!fs.existsSync(configPath)) {
    console.error(`[kimi-web-renamer] 未找到 sidecar 配置，请先运行: node "${path.join(ROOT, "bin", "cli.js")}" patch`);
    process.exit(1);
  }

  let config;
  try {
    config = JSON.parse(fs.readFileSync(configPath, "utf8"));
  } catch (err) {
    console.error(`[kimi-web-renamer] 无法读取 sidecar 配置 (${configPath}): ${err.message}`);
    process.exit(1);
  }

  const port = Number(process.env.KIMI_RENAMER_PORT || config.port || 58629);
  if (!Number.isInteger(port) || port < 1 || port > 65535) {
    console.error(`[kimi-web-renamer] 无效的 sidecar 端口: ${port}`);
    process.exit(1);
  }

  let sidecarChild = null;
  let stopReinjector = null;
  let kimiChild = null;
  let cleanedUp = false;

  const cleanup = () => {
    if (cleanedUp) return;
    cleanedUp = true;
    if (stopReinjector) {
      try {
        stopReinjector();
      } catch (e) {
        // 忽略
      }
      stopReinjector = null;
    }
    if (sidecarChild && sidecarChild.exitCode === null) {
      try {
        sidecarChild.kill();
      } catch (e) {
        // 忽略已退出的进程
      }
    }
  };

  process.on("exit", cleanup);

  const forwardSignal = (sig, fallbackCode) => {
    if (kimiChild && kimiChild.exitCode === null) {
      try {
        kimiChild.kill(sig);
      } catch (e) {
        // 忽略
      }
      setTimeout(() => {
        cleanup();
        process.exit(fallbackCode);
      }, 3000).unref();
      return;
    }
    cleanup();
    process.exit(fallbackCode);
  };

  process.on("SIGINT", () => forwardSignal("SIGINT", 130));
  process.on("SIGTERM", () => forwardSignal("SIGTERM", 143));

  if (!(await checkHealth(port))) {
    let sidecarExited = false;
    let sidecarStderr = "";
    sidecarChild = spawn(process.execPath, [path.join(ROOT, "src", "standalone", "server.js")], {
      windowsHide: true,
      stdio: ["ignore", "ignore", "pipe"],
      env: {
        ...process.env,
        KIMI_RENAMER_PORT: String(port),
      },
    });
    if (sidecarChild.stderr) {
      sidecarChild.stderr.on("data", (chunk) => {
        sidecarStderr += chunk.toString("utf8");
      });
    }
    sidecarChild.on("exit", () => {
      sidecarExited = true;
    });
    sidecarChild.on("error", (err) => {
      sidecarStderr += err.message;
      sidecarExited = true;
    });

    let healthy = false;
    for (let i = 0; i < 50; i++) {
      if (await checkHealth(port)) {
        healthy = true;
        break;
      }
      if (sidecarExited) break;
      await sleep(100);
    }

    if (!healthy) {
      const detail = sidecarStderr.trim();
      console.error(
        `[kimi-web-renamer] sidecar 启动失败（端口 ${port}）${detail ? `: ${detail}` : ""}`
      );
      cleanup();
      process.exit(1);
    }
    console.log(`[kimi-web-renamer] sidecar 已启动: http://127.0.0.1:${port}/`);
  }

  stopReinjector = startInlineReinjector(configPath);

  const kimiBin = process.env.KIMI_BIN || "kimi";
  kimiChild = spawnKimiWeb(kimiBin, process.argv.slice(2));

  kimiChild.on("error", (err) => {
    if (err.code === "ENOENT") {
      console.error("[kimi-web-renamer] 找不到 kimi 可执行文件，请确认 Kimi Code 已安装并加入 PATH");
    } else {
      console.error(`[kimi-web-renamer] 启动 kimi web 失败: ${err.message}`);
    }
    cleanup();
    process.exit(1);
  });

  kimiChild.on("exit", (code, signal) => {
    cleanup();
    if (signal) process.exit(1);
    process.exit(code ?? 0);
  });
}

if (require.main === module) {
  main().catch((err) => {
    console.error(`[kimi-web-renamer] 运行失败: ${err.message || err}`);
    process.exit(1);
  });
}

module.exports = {
  quoteCmdArg,
  spawnKimiWeb,
  startInlineReinjector,
};

#!/usr/bin/env bash
# 安装并启动 kimi-renamer 守护进程（systemd 用户服务）。
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NODE="$(command -v node || true)"
UNIT_DIR="$HOME/.config/systemd/user"
UNIT="$UNIT_DIR/kimi-renamer-watch.service"

if [ -z "$NODE" ]; then
  echo "找不到 node，请先安装 Node.js 18+" >&2
  exit 1
fi

if [ ! -d /run/systemd/system ]; then
  echo "当前环境没有 systemd，请在 shell 启动脚本里加入：" >&2
  echo "  pgrep -f src/standalone/daemon.js >/dev/null || nohup \"$NODE\" \"$ROOT/src/standalone/daemon.js\" >/dev/null 2>&1 &" >&2
  exit 1
fi

mkdir -p "$UNIT_DIR"
cat > "$UNIT" <<EOF
[Unit]
Description=Kimi Code Web renamer watcher
After=default.target

[Service]
Type=simple
ExecStart=$NODE $ROOT/src/standalone/daemon.js
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
EOF

systemctl --user daemon-reload
systemctl --user enable --now kimi-renamer-watch.service
loginctl enable-linger "$USER" 2>/dev/null || true

echo "✅ 守护进程已安装并启动: $UNIT"
systemctl --user --no-pager status kimi-renamer-watch.service | head -8

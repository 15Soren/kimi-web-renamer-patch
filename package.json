{
  "name": "kimi-web-renamer-patch",
  "version": "1.1.0",
  "description": "一键将 AI 对话自动命名功能补丁（Patch）注入到原生的 Kimi Code Web 客户端中，直接复用 Kimi 本身的模型配置与 config.toml",
  "main": "src/patcher.js",
  "bin": {
    "kimi-patch": "./bin/cli.js"
  },
  "scripts": {
    "patch": "node bin/cli.js patch",
    "unpatch": "node bin/cli.js unpatch",
    "status": "node bin/cli.js status",
    "models": "node bin/cli.js models",
    "test": "node test/test-mock.js && node test/test-config.js && node test/test-regressions.js"
  },
  "keywords": [
    "kimi",
    "kimi-code",
    "patch",
    "auto-rename",
    "ai",
    "config.toml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zluoshui/kimi-web-renamer-patch.git"
  },
  "author": "zluoshui",
  "license": "MIT"
}
